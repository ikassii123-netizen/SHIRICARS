# Copier ce fichier en .env.local et remplir avec vos vraies valeurs Supabase
# Settings > API dans votre dashboard Supabase

NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre-cle-anon-publique

# Email admin pour se connecter au panneau d'administration
NEXT_PUBLIC_ADMIN_EMAIL=votre-email@exemple.com

# ── Notifications email ───────────────────────────────────────────────────────
# Clé API Resend (resend.com → API Keys). Ne jamais préfixer par NEXT_PUBLIC_ :
# cette clé doit rester uniquement côté serveur.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
